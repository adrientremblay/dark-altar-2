[node name="Dialogue" type="Node" parent="."]

[node name="Skulls" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("25_lswn8")
script = ExtResource("26_a6jrf")
transcript = "Skulls? What manner of witchcraft is this? (laughing). Nonetheless if remains even those of alleged heretics are left unburied it is my duty to collect them."

[node name="VillageBearsNoLight" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("27_a6jrf")
script = ExtResource("26_a6jrf")
transcript = "This village bears no light. And I sense no souls sleep within these hovels. This place is abandoned. The villagers having fled. Spreading rumours of their kin gone missing in the night."

[node name="PatheticFarm" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("28_xuqvo")
script = ExtResource("26_a6jrf")
transcript = "This pathetic farm is in ruin. It has not seen the touch of a fieldsman in years. Not even wild plants - the wicked theives of the soil grow here. The wind speaks only to the bones of forgotten beasts - left to bleach in the sun unceremoniously."

[node name="PaganMagic" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("29_qsp4k")
script = ExtResource("26_a6jrf")
transcript = "What is this place? There is a strong Pagan magic here. They worhsip demons in disguise and call them gods. These old stones should have been destroyed long ago. When the church hears of this it shall be done."

[node name="BeautifulCemetary" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("30_kq58d")
script = ExtResource("26_a6jrf")
transcript = "A beatiful cemetary for such a quaint village. I always found such peace in places like this. Ther are many skulls here, only one speaks to me. I must find it."

[node name="HereLiesMayorKiesel" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("31_seu75")
script = ExtResource("26_a6jrf")
transcript = "Ah. Here lies what must be mayor Kiesel. The last to part this village. Or at least try to. Your note was most invaluable. I will cleanse this place. I promise it."

[node name="ThisThisThisMan" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("32_htxhm")
script = ExtResource("26_a6jrf")
transcript = "This man. This fallen priest. Is not of this world. I can't... bear to look at him. He is only now a vessel. Marked by hell. The devil walks in his skin."

[node name="WretchedLair" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("33_jq2sk")
script = ExtResource("26_a6jrf")
transcript = "A wretched lair built into a church? How sinister."

[node name="SpecialCross" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("34_4k2k6")
script = ExtResource("26_a6jrf")
transcript = "This cross is special. I can feel it. Cedric Leopold I smite thee!"

[node name="SoTheseAreTheVillagers" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("35_0rl1p")
script = ExtResource("26_a6jrf")
transcript = "So these are the villagers. The mystery is solved. God rest their souls."

[node name="BooksShallBurn" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("37_facbu")
script = ExtResource("26_a6jrf")
transcript = "These acursed books shall burn if I survive this night."

[node name="SkullWithHorns" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("38_b1qrp")
script = ExtResource("26_a6jrf")
transcript = "What in gods name is this? A skull with horns. It can only be one thing."

[node name="WowTheDarkAlter" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("39_come4")
script = ExtResource("26_a6jrf")
transcript = "My god. The Dark Altar. I thought it was myth. I must place the skulls."

[node name="TheVillageIsFree" type="AudioStreamPlayer" parent="Dialogue"]
stream = ExtResource("40_h8e4i")
script = ExtResource("26_a6jrf")
transcript = "Finally. It is done. The village is free."

