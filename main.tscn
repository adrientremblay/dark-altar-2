[node name="RemainsPage" parent="NavigationRegion3D/Church/ChurchDoor" instance=ExtResource("20_b2i1c")]
transform = Transform3D(-0.0411784, 0.999152, 3.27788e-08, -3.0243e-08, 3.15602e-08, -1, -0.999152, -0.0411777, 2.89177e-08, 0.0626355, 1.60383, -2.83073)
page_title = "Church Note"
page_text = "To whoever reads this note, know that your doom was wrought by the wayward priest Cedric Leopold. Who with his five loyal followers, brought ruin to this village. He betrayed them all. He betrayed this village and he betrayed mighty god himself. You must find the five skulls of his followers: the so called \"Order of the Dark Altar\". They are hidden nearby. Bring their skulls to the summoning chamber atop the mountain. It is the only way to break the seal. My days are numbered. Christ grant you strength whoever you may be.

- Mayor Kiesel"

